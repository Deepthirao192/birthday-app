pipeline {
agent any

stages {
stage('Checkout') {
steps {
checkout scm
}
}

stage('Build Docker Image') {
steps {
sh 'docker build -t birthday-app:v1 .'
}
}

stage('Verify Docker Image') {
steps {
sh 'docker images'
}
}
stage('Deploy Docker Container') {
steps {
sh 'docker rm -f birthday-app || true'
sh 'docker run -d --name birthday-app -p 80:80 birthday-app:v1'
}
}
}

post {
success {
echo '🎉 Birthday App Pipeline Completed Successfully!'
}

failure {
echo '❌ Pipeline Failed'
}
}
}
