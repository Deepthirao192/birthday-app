pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t birthday-app:v1 .'
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh 'docker images'
            }
        }

        stage('Load Image into Minikube') {
            steps {
                sh 'minikube image load birthday-app:v1'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                kubectl apply -f kubernetes/deployment.yaml
                kubectl apply -f kubernetes/service.yaml
                '''
            }
        }

        stage('Restart Kubernetes Deployment') {
            steps {
                sh '''
                kubectl rollout restart deployment birthday-app
                kubectl rollout status deployment birthday-app
                '''
            }
        }

        stage('Verify Kubernetes Deployment') {
            steps {
                sh '''
                echo "===== Deployments ====="
                kubectl get deployments

                echo "===== Pods ====="
                kubectl get pods

                echo "===== Services ====="
                kubectl get svc
                '''
            }
        }

        stage('Docker Cleanup') {
            steps {
                sh 'docker image prune -f'
            }
        }
    }

    post {
        success {
            echo '🎉 Birthday App deployed successfully to Kubernetes!'
        }

        failure {
            echo '❌ Pipeline Failed'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}